NODE_ENV=production
PORT=3000

# Ganti semua nilai ini sebelum deploy. Jangan commit file .env asli.
# Buat secret dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_PIN=change-this-pin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Optional hardening limits
ADMIN_SESSION_TTL_MS=28800000
MAX_JSON_SIZE=150kb
MAX_IMAGE_SIZE=3145728
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=5
