NODE_ENV=production
PORT=3000

# Ganti semua nilai ini sebelum deploy. Jangan commit file .env asli.
# Buat secret dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_PIN=change-this-pin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret
CUSTOMER_SESSION_SECRET=generate-another-long-random-secret

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/annie_catering?schema=public

# Optional seed admin. Jangan pakai password contoh di production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-seed-password

# Optional hardening limits
ADMIN_SESSION_TTL_MS=28800000
CUSTOMER_SESSION_TTL_MS=1209600000
MAX_JSON_SIZE=150kb
MAX_IMAGE_SIZE=3145728
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=5

# Storage abstraction. Gunakan local hanya untuk development.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=../public/uploads

# Mock payment sandbox. Jangan dipakai sebagai bukti pembayaran production.
MOCK_PAYMENT_WEBHOOK_SECRET=generate-a-long-random-mock-webhook-secret
DEFAULT_PLATFORM_COMMISSION_BPS=500
