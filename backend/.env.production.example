NODE_ENV=production
PORT=3000

# Kunci rahasia produksi (dibuat menggunakan crypto.randomBytes(48).toString('base64url'))
ADMIN_PIN=change-this-pin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret
CUSTOMER_SESSION_SECRET=generate-another-long-random-secret

# PostgreSQL / Prisma Produksi
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/annie_catering?schema=public

# Kredensial Inisialisasi Admin
SEED_ADMIN_EMAIL=admin@citarasacatering.com
SEED_ADMIN_PASSWORD=change-this-seed-password

# Batas Keamanan & Sesi
ADMIN_SESSION_TTL_MS=28800000
CUSTOMER_SESSION_TTL_MS=1209600000
MAX_JSON_SIZE=150kb
MAX_IMAGE_SIZE=3145728
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=5

# Driver Storage Produksi
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=../public/uploads

# Mock Payment Sandbox
MOCK_PAYMENT_WEBHOOK_SECRET=generate-a-long-random-mock-webhook-secret
DEFAULT_PLATFORM_COMMISSION_BPS=500

