// Citarasa Catering - skema database single-tenant.
// Satu usaha, satu pemilik, banyak pelanggan.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Peran {
  PEMILIK
  PELANGGAN
  STAF_DAPUR
}

enum KategoriMenu {
  SNACK
  NASI_KOTAK
  TUMPENG
  NASI_GORENG
}

enum StatusPesanan {
  BARU
  DIKONFIRMASI
  DIPROSES
  SIAP
  SELESAI
  DIBATALKAN
}

enum StatusBayar {
  BELUM_BAYAR
  MENUNGGU_VERIFIKASI
  /// Sudah ada pembayaran (mis. DP) tetapi belum menutup total.
  SEBAGIAN
  LUNAS
}

/// Asal pesanan. Pesanan yang dicatat pemilik dari WA/telepon tetap terhitung
/// di laporan, dan pemilik bisa melihat saluran mana yang paling ramai.
enum SumberPesanan {
  WEBSITE
  WHATSAPP
  TELEPON
  LANGSUNG
}

enum JenisPembayaran {
  DP
  PELUNASAN
  REFUND
}

enum CaraAmbil {
  AMBIL_SENDIRI
  DIANTAR
}

enum CaraBayar {
  TRANSFER
  TUNAI
}

enum JenisKas {
  MASUK
  KELUAR
}

enum JenisPotongan {
  NOMINAL
  PERSEN
}

enum SumberKas {
  PESANAN
  MANUAL
}

model Pengguna {
  id           String   @id @default(cuid())
  nama         String
  // Nomor HP dipakai sebagai identitas login: pelanggan UMKM hafal nomornya,
  // belum tentu punya/ingat email.
  telepon      String   @unique
  email        String?
  sandiHash    String
  peran        Peran    @default(PELANGGAN)
  alamat       String?
  /// Token sesi yang terbit sebelum waktu ini ditolak (untuk peran istimewa).
  /// Diperbarui saat sandi diganti, supaya perangkat lain yang mungkin dipegang
  /// orang lain langsung keluar.
  sesiSejak    DateTime @default(now())
  dibuatPada   DateTime @default(now())
  diubahPada   DateTime @updatedAt

  pesanan      Pesanan[]
  catatanKas   CatatanKas[]
  riwayatStatus RiwayatStatus[]
  pembayaran   Pembayaran[]
  aktivitas    LogAktivitas[]

  @@index([peran])
}

model Menu {
  id             String       @id @default(cuid())
  nama           String
  slug           String       @unique
  deskripsi      String
  kategori       KategoriMenu
  harga          Int
  satuan         String       @default("porsi")
  minPesan       Int          @default(1)
  aktif          Boolean      @default(true)
  // Tumpeng & pesanan besar butuh waktu siap. 0 = bisa dipesan hari ini juga.
  preorderHari   Int          @default(0)
  kapasitasHarian Int?
  urutan         Int          @default(0)
  dibuatPada     DateTime     @default(now())
  diubahPada     DateTime     @updatedAt

  item           ItemPesanan[]
  foto           FotoMenu[]
  resep          ResepMenu[]

  @@index([kategori, aktif])
  @@index([aktif, urutan])
}

/// Galeri foto per menu. Pembeli katering memutuskan lewat mata: satu foto
/// tidak cukup untuk menunjukkan isi box, porsi, dan penyajiannya sekaligus.
/// Foto dengan `urutan` terkecil dipakai sebagai sampul di kartu menu.
model FotoMenu {
  id         String   @id @default(cuid())
  menuId     String
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  url        String
  keterangan String?
  urutan     Int      @default(0)
  dibuatPada DateTime @default(now())

  @@index([menuId, urutan])
}

model Pesanan {
  id             String        @id @default(cuid())
  kode           String        @unique

  // Pesanan boleh dibuat tanpa akun (tamu). Kalau pemesan login, tersambung ke akunnya.
  penggunaId     String?
  pengguna       Pengguna?     @relation(fields: [penggunaId], references: [id], onDelete: SetNull)

  namaPemesan    String
  teleponPemesan String
  alamatAntar    String?

  // Titik antar dari peta. Alamat tertulis tetap sumber utama; koordinat hanya
  // pelengkap supaya pengantar tidak tersesat di gang yang tidak punya nama.
  latitude       Float?
  longitude      Float?

  caraAmbil      CaraAmbil     @default(AMBIL_SENDIRI)
  tanggalAcara   DateTime
  jamAcara       String
  catatan        String?

  status         StatusPesanan @default(BARU)
  statusBayar    StatusBayar   @default(BELUM_BAYAR)
  caraBayar      CaraBayar     @default(TRANSFER)

  subtotal       Int
  ongkir         Int           @default(0)
  diskon         Int           @default(0)
  total          Int

  voucherId      String?
  voucher        Voucher?      @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  /// Snapshot kode voucher: nota lama tetap terbaca benar walau vouchernya
  /// kemudian diganti atau dihapus (invarian #2).
  kodeVoucher    String?
  /// Jumlah bersih yang sudah diterima (DP + pelunasan − refund). Selalu
  /// diubah di transaksi yang sama dengan baris Pembayaran-nya.
  dibayar        Int           @default(0)
  /// Snapshot DP minimal saat pesanan dibuat; perubahan persen DP di
  /// Pengaturan tidak mengubah tagihan pesanan lama (invarian #2).
  minimalDp      Int           @default(0)
  sumber         SumberPesanan @default(WEBSITE)
  /// Bukti transfer yang belum diverifikasi. Setelah dicatat sebagai
  /// pembayaran, URL-nya pindah ke Pembayaran.buktiUrl.
  buktiBayarUrl  String?

  dikonfirmasiPada DateTime?
  selesaiPada    DateTime?
  alasanBatal    String?

  dibuatPada     DateTime      @default(now())
  diubahPada     DateTime      @updatedAt

  item           ItemPesanan[]
  riwayat        RiwayatStatus[]
  kas            CatatanKas[]
  pembayaran     Pembayaran[]

  @@index([status, tanggalAcara])
  @@index([tanggalAcara])
  @@index([teleponPemesan])
  @@index([dibuatPada])
  /// Dipakai papan dapur untuk mendeteksi perubahan (denyut) tanpa memuat ulang.
  @@index([diubahPada])
  @@index([statusBayar])
  /// Route `/unggahan/[nama]` mencari pemilik sah sebuah bukti transfer lewat
  /// kolom ini pada setiap permintaan gambar; tanpa indeks, tiap kartu pesanan
  /// yang menampilkan bukti memicu pemindaian seluruh tabel pesanan.
  @@index([buktiBayarUrl])
}

model ItemPesanan {
  id          String   @id @default(cuid())
  pesananId   String
  pesanan     Pesanan  @relation(fields: [pesananId], references: [id], onDelete: Cascade)

  menuId      String?
  menu        Menu?    @relation(fields: [menuId], references: [id], onDelete: SetNull)

  // Snapshot: nama & harga dibekukan saat pesanan dibuat supaya nota lama
  // tidak ikut berubah kalau harga menu naik atau menunya dihapus.
  namaMenu    String
  hargaSatuan Int
  satuan      String
  jumlah      Int
  catatan     String?
  subtotal    Int
  /// Snapshot biaya bahan per satuan saat pesanan dibuat (dari resep). Null
  /// bila menunya belum punya resep. Membuat laporan margin lama tetap benar.
  hppSatuan   Int?

  @@index([pesananId])
  @@index([menuId])
}

model RiwayatStatus {
  id         String         @id @default(cuid())
  pesananId  String
  pesanan    Pesanan        @relation(fields: [pesananId], references: [id], onDelete: Cascade)
  dari       StatusPesanan?
  ke         StatusPesanan
  catatan    String?
  olehId     String?
  oleh       Pengguna?      @relation(fields: [olehId], references: [id], onDelete: SetNull)
  dibuatPada DateTime       @default(now())

  @@index([pesananId, dibuatPada])
}

model CatatanKas {
  id          String    @id @default(cuid())
  jenis       JenisKas
  sumber      SumberKas @default(MANUAL)
  kategori    String
  keterangan  String
  jumlah      Int
  tanggal     DateTime

  // Pesanan bisa punya beberapa baris kas (DP, pelunasan, refund). Yang
  // mencegah pencatatan ganda kini `pembayaranId @unique`: satu pembayaran
  // tepat satu baris kas (invarian #3).
  pesananId   String?
  pesanan     Pesanan?  @relation(fields: [pesananId], references: [id], onDelete: SetNull)
  pembayaranId String?  @unique
  pembayaran  Pembayaran? @relation(fields: [pembayaranId], references: [id], onDelete: SetNull)

  dicatatOlehId String?
  dicatatOleh   Pengguna? @relation(fields: [dicatatOlehId], references: [id], onDelete: SetNull)

  dibuatPada  DateTime  @default(now())

  @@index([tanggal])
  @@index([jenis, tanggal])
  @@index([pesananId])
}

/// Satu uang yang benar-benar diterima atau dikembalikan untuk sebuah pesanan.
model Pembayaran {
  id            String          @id @default(cuid())
  pesananId     String
  pesanan       Pesanan         @relation(fields: [pesananId], references: [id], onDelete: Cascade)
  jenis         JenisPembayaran
  metode        CaraBayar
  /// Selalu positif; arah uang ditentukan `jenis` (REFUND = keluar).
  jumlah        Int
  buktiUrl      String?
  catatan       String?
  dicatatOlehId String?
  dicatatOleh   Pengguna?       @relation(fields: [dicatatOlehId], references: [id], onDelete: SetNull)
  dibuatPada    DateTime        @default(now())
  kas           CatatanKas?

  @@index([pesananId, dibuatPada])
  @@index([buktiUrl])
}

/// Bahan baku dengan harga belinya. Dipakai resep untuk daftar belanja & HPP.
model Bahan {
  id             String      @id @default(cuid())
  nama           String      @unique
  /// kg, liter, butir, ikat, pcs, ...
  satuan         String
  hargaPerSatuan Int
  aktif          Boolean     @default(true)
  dibuatPada     DateTime    @default(now())
  diubahPada     DateTime    @updatedAt
  resep          ResepMenu[]
}

model ResepMenu {
  id             String @id @default(cuid())
  menuId         String
  menu           Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  bahanId        String
  bahan          Bahan  @relation(fields: [bahanId], references: [id], onDelete: Restrict)
  /// Takaran untuk SATU satuan menu (mis. 0.15 kg ayam per kotak).
  jumlahPerPorsi Float

  @@unique([menuId, bahanId])
  @@index([bahanId])
}

/// Jejak tindakan penting untuk audit keamanan & menelusuri kesalahan input.
model LogAktivitas {
  id         String    @id @default(cuid())
  penggunaId String?
  pengguna   Pengguna? @relation(fields: [penggunaId], references: [id], onDelete: SetNull)
  aksi       String
  target     String?
  rincian    String?
  dibuatPada DateTime  @default(now())

  @@index([dibuatPada])
}

/// Arsip rekap bulanan XLSX yang dibuat otomatis oleh tugas terjadwal.
model RekapBulanan {
  id         String   @id @default(cuid())
  /// "2026-09"
  bulan      String   @unique
  berkas     String
  ukuran     Int
  dibuatPada DateTime @default(now())
}

/// Kode promo. Nilai potongan SELALU dihitung ulang di server saat pesanan
/// dibuat — kode yang dikirim browser hanya dipakai untuk mencari barisnya,
/// tidak pernah untuk menentukan besar potongan (lihat invarian #1).
model Voucher {
  id           String        @id @default(cuid())
  /// Selalu disimpan huruf besar supaya pencocokan tidak bergantung cara ketik pembeli.
  kode         String        @unique
  deskripsi    String?
  jenis        JenisPotongan @default(NOMINAL)
  /// Rupiah bila NOMINAL, angka persen (1-100) bila PERSEN.
  nilai        Int
  /// Batas atas potongan untuk voucher persen. Null = tanpa batas.
  maksPotongan Int?
  minBelanja   Int           @default(0)
  /// Null = tanpa batas pemakaian.
  kuota        Int?
  terpakai     Int           @default(0)
  mulaiPada    DateTime?
  berakhirPada DateTime?
  aktif        Boolean       @default(true)
  dibuatPada   DateTime      @default(now())
  diubahPada   DateTime      @updatedAt

  pesanan      Pesanan[]

  @@index([aktif, berakhirPada])
}

model TanggalTutup {
  id      String   @id @default(cuid())
  tanggal DateTime @unique
  alasan  String?
}

/// Jenis peristiwa yang dilacak untuk mengukur corong (funnel) pemesanan.
/// Sengaja dibatasi pada langkah yang punya arti bisnis, bukan tiap klik.
enum JenisPeristiwa {
  MENU_DILIHAT
  FORM_PESAN_DIBUKA
  PESANAN_DIBUAT
  LACAK_DIPAKAI
}

/// Jumlah tampilan halaman per hari, sudah teragregasi sejak ditulis.
/// Tidak ada baris per-kunjungan, jadi tidak ada jejak individual yang bisa
/// dibongkar belakangan.
model KunjunganHarian {
  id       String   @id @default(cuid())
  tanggal  DateTime
  path     String
  tampilan Int      @default(0)

  @@unique([tanggal, path])
  @@index([tanggal])
}

/// Penghitung pengunjung unik per hari tanpa menyimpan identitas.
/// `sidik` adalah hash SHA-256 dari (IP + user agent + garam harian acak) yang
/// tidak disimpan di mana pun. Karena garamnya berganti tiap hari, sidik yang
/// sama tidak bisa dihubungkan antar hari, dan tidak bisa dibalik jadi IP.
/// Inilah alasan situs ini tidak memerlukan banner persetujuan cookie.
model JejakPengunjung {
  id      String   @id @default(cuid())
  tanggal DateTime
  sidik   String

  @@unique([tanggal, sidik])
  @@index([tanggal])
}

/// Peristiwa corong pemesanan, juga teragregasi per hari.
model PeristiwaAnalitik {
  id      String         @id @default(cuid())
  tanggal DateTime
  jenis   JenisPeristiwa
  jumlah  Int            @default(0)

  @@unique([tanggal, jenis])
  @@index([tanggal])
}

model Pengaturan {
  id             String  @id @default("utama")
  namaUsaha      String  @default("Citarasa Catering")
  tagline        String  @default("Masakan hangat, siap tepat waktu.")
  cerita         String  @default("")
  whatsapp       String  @default("")
  alamat         String  @default("")
  jamBuka        String  @default("16:00")
  jamTutup       String  @default("23:00")
  namaBank       String  @default("")
  nomorRekening  String  @default("")
  namaRekening   String  @default("")
  ongkirDefault  Int     @default(0)
  minOrderAntar  Int     @default(0)
  /// Persen DP minimal untuk pembayaran transfer. 0 = tanpa DP (wajib lunas).
  persenDp       Int     @default(0)
  /// Pesanan transfer tanpa pembayaran dibatalkan otomatis setelah sekian jam.
  /// 0 = fitur mati.
  batasBayarJam  Int     @default(0)
  /// Kapan tugas terjadwal (cron) terakhir berjalan.
  tugasTerakhir  DateTime?
  diubahPada     DateTime @updatedAt
}
