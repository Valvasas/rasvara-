# Koneksi database PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/citarasa?schema=public"

# Kunci rahasia untuk menandatangani cookie sesi login.
# WAJIB diganti di server produksi. Minimal 32 karakter acak.
# Cara bikin: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="ganti-dengan-kunci-acak-minimal-32-karakter"

# Alamat publik website (dipakai untuk link di pesan WhatsApp)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Tempat menyimpan bukti transfer & foto menu. Sengaja di luar public/: berkas
# di public/ dilayani apa adanya kepada siapa pun yang tahu URL-nya, sedangkan
# bukti transfer hanya boleh dibuka dapur dan pemilik pesanannya (lihat
# src/app/unggahan/[nama]/route.ts). Folder inilah yang perlu ikut dicadangkan.
DIREKTORI_UNGGAHAN="./data/unggahan"

# Berapa reverse-proxy tepercaya yang berdiri di depan aplikasi ini.
# Header x-forwarded-for / x-real-ip bisa ditulis siapa saja yang mengirim
# permintaan; yang membuatnya dapat dipercaya hanyalah proxy di depan yang
# menimpanya. Salah isi di sini membuat pembatas laju bisa dilewati begitu saja.
#   1 = susunan lazim "nginx -> aplikasi" (lihat PRODUCTION.md)
#   0 = aplikasi terbuka langsung ke internet, header tidak dipercaya sama sekali
PROXY_TEPERCAYA="1"

# Batas koneksi database yang dibuka aplikasi. Naikkan bila pengunjung serentak
# banyak, tapi jangan melebihi max_connections milik PostgreSQL.
# (Di Vercel bawaannya otomatis 5 — tidak perlu diisi.)
DB_POOL_MAX="20"

# --- Hanya untuk Supabase / Vercel (biarkan kosong untuk pengembangan lokal) ---
# Koneksi untuk MIGRASI (prisma migrate). Bila kosong, DATABASE_URL yang dipakai.
# Di Supabase: DATABASE_URL = Transaction pooler (port 6543, untuk aplikasi),
# DIRECT_URL = Session pooler / direct (port 5432, untuk migrasi dari laptop).
# DIRECT_URL=""
#
# Supabase Storage untuk foto menu & bukti transfer. Bila keduanya terisi,
# berkas disimpan di bucket `menu` & `bukti-transfer` (keduanya PRIVAT), bukan
# di DIREKTORI_UNGGAHAN. Kunci secret/service_role hanya di server — JANGAN
# beri awalan NEXT_PUBLIC_.
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
#
# Opsional: sertifikat CA Supabase (isi PEM) agar TLS memverifikasi server.
# DB_SSL_CA=""
