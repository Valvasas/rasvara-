# Koneksi database PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/citarasa?schema=public"

# Kunci rahasia untuk menandatangani cookie sesi login.
# WAJIB diganti di server produksi. Minimal 32 karakter acak.
# Cara bikin: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="ganti-dengan-kunci-acak-minimal-32-karakter"

# Alamat publik website (dipakai untuk link di pesan WhatsApp)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
