# ==============================================================================
# CITARASA CATERING (RASVARA) - TEMPLAT KONFIGURASI PRODUKSI
# ==============================================================================
# Petunjuk:
# 1. Salin berkas ini menjadi `.env.production` di server.
# 2. Ganti semua nilai bertanda GANTI dengan kredensial asli Anda.
# 3. JANGAN PERNAH commit `.env.production` yang berisi kredensial asli.
#
# Menjalankan dengan Docker Compose — perhatikan `--env-file`:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Tanpa `--env-file`, Docker Compose membaca variabel seperti ${POSTGRES_PASSWORD}
# dari berkas `.env` biasa, bukan dari berkas di bawah `env_file:` — sehingga
# database akan dibuat dengan sandi yang berbeda dari yang dipakai aplikasi.
# ==============================================================================

# Mode Operasional
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# URL Publik Situs (wajib HTTPS di produksi)
# Dipakai untuk tautan di pesan WhatsApp, metadata Open Graph, sitemap, robots.txt.
NEXT_PUBLIC_BASE_URL="https://citarasacatering.com"

# --- Database ---------------------------------------------------------------
# Dipakai Docker Compose untuk membuat kontainer PostgreSQL. Samakan dengan
# kredensial di DATABASE_URL.
POSTGRES_USER="citarasa_user"
POSTGRES_PASSWORD="GANTI_sandi_database_yang_kuat"
POSTGRES_DB="citarasa"

# Dipakai aplikasi. Di dalam Docker Compose nilai ini ditimpa (host jadi `db`).
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://citarasa_user:GANTI_sandi_database_yang_kuat@localhost:5432/citarasa?schema=public"

# --- Sesi -------------------------------------------------------------------
# Menandatangani cookie sesi login ('sesi_citarasa') dan cookie akses pesanan
# tamu ('pesanan_saya'). Minimal 32 karakter dengan entropi kriptografis.
# Buat baru: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="GANTI_dengan_kunci_acak_minimal_32_karakter"

# --- Penyimpanan berkas unggahan --------------------------------------------
# Bukti transfer & foto menu. Di luar public/ dengan sengaja, karena bukti
# transfer hanya boleh dilayani lewat route yang memeriksa wewenang.
# Folder ini menyimpan data yang tidak ada di database — wajib ikut dicadangkan.
DIREKTORI_UNGGAHAN="./data/unggahan"

# --- Jaringan ---------------------------------------------------------------
# Berapa banyak reverse proxy tepercaya di depan aplikasi:
#   1 = susunan umum (Nginx -> Next.js, atau Cloudflare -> VPS)
#   2 = multi-hop (Cloudflare -> Nginx -> Next.js)
#   0 = tanpa reverse proxy (header penerusan tidak dipercaya sama sekali)
# Salah isi membuat pembatas laju bisa dilewati begitu saja.
PROXY_TEPERCAYA="1"

# --- Pool koneksi database (VPS 2-4 core: 20-30) ----------------------------
DB_POOL_MAX="20"
DB_CONNECT_TIMEOUT_MS="5000"

# --- Inisialisasi akun (hanya dipakai saat `npm run db:seed` pertama kali) ---
SEED_TELEPON_PEMILIK="GANTI_6281234567890"
SEED_SANDI_PEMILIK="GANTI_SandiKuatPemilik123!"
SEED_NAMA_PEMILIK="Pemilik Citarasa"
SEED_SANDI_STAF="GANTI_SandiKuatDapur123!"

# Kontrol data demo (0 = bersih, 1 = isi contoh pesanan)
# PERINGATAN: di produksi wajib 0, supaya pesanan dummy tidak masuk ke buku kas.
SEED_DEMO="0"
